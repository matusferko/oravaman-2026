# Strava app: https://www.strava.com/settings/api
# Authorization Callback Domain: localhost (dev) + matusferko.github.io (prod)
# Redirect URI must match the app URL exactly, e.g. http://localhost:5173/oravaman-2026/

VITE_STRAVA_CLIENT_ID=your_strava_client_id

# Local dev: Vite dev server proxies /oravaman-2026/api/strava/token (leave unset)
# Production: deployed Supabase Edge Function URL
# VITE_STRAVA_TOKEN_PROXY_URL=https://YOUR_PROJECT.supabase.co/functions/v1/strava-token

# Server-only (never prefix with VITE_) — used by Vite dev proxy and Supabase function
STRAVA_CLIENT_SECRET=your_strava_client_secret

# PIN required to trigger Strava sync — validated server-side, never exposed to the client
SYNC_PIN=your_pin_here
